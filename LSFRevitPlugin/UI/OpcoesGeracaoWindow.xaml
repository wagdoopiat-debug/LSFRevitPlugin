<Window x:Class="LSFRevitPlugin.UI.OpcoesGeracaoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LSF Modeler - Opcoes de Geracao"
        Width="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <StackPanel Margin="16">

        <TextBlock Text="Sistema:" FontWeight="Bold" Margin="0,0,0,4"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton x:Name="RadioSistemaSteelFrame" Content="Steel Frame" GroupName="Sistema"
                         Checked="RadioSistema_Checked" Margin="0,0,16,0"/>
            <RadioButton x:Name="RadioSistemaDrywall" Content="Drywall" GroupName="Sistema"
                         Checked="RadioSistema_Checked"/>
        </StackPanel>

        <TextBlock Text="Largura do perfil (alma):" FontWeight="Bold" Margin="0,4,0,4"/>

        <StackPanel x:Name="PanelLarguraSteelFrame" Orientation="Horizontal" Margin="0,0,0,4">
            <RadioButton x:Name="RadioLargura90SF" Content="90 mm" GroupName="LarguraSteelFrame" Margin="0,0,12,0"/>
            <RadioButton x:Name="RadioLargura140SF" Content="140 mm" GroupName="LarguraSteelFrame" Margin="0,0,12,0"/>
            <RadioButton x:Name="RadioLargura200SF" Content="200 mm" GroupName="LarguraSteelFrame"/>
        </StackPanel>

        <StackPanel x:Name="PanelLarguraDrywall" Orientation="Horizontal" Margin="0,0,0,4">
            <RadioButton x:Name="RadioLargura48DW" Content="48 mm" GroupName="LarguraDrywall" Margin="0,0,12,0"/>
            <RadioButton x:Name="RadioLargura70DW" Content="70 mm" GroupName="LarguraDrywall" Margin="0,0,12,0"/>
            <RadioButton x:Name="RadioLargura90DW" Content="90 mm" GroupName="LarguraDrywall"/>
        </StackPanel>

        <TextBlock Text="Bitola (espessura da chapa):" FontWeight="Bold" Margin="0,4,0,4"/>

        <StackPanel x:Name="PanelBitolaSteelFrame" Orientation="Horizontal" Margin="0,0,0,4">
            <RadioButton x:Name="RadioBitola080" Content="0,80 mm" GroupName="Bitola" Margin="0,0,12,0"/>
            <RadioButton x:Name="RadioBitola095" Content="0,95 mm" GroupName="Bitola" Margin="0,0,12,0"/>
            <RadioButton x:Name="RadioBitola125" Content="1,25 mm" GroupName="Bitola"/>
        </StackPanel>

        <TextBlock x:Name="TextBitolaFixaDrywall" Text="0,50 mm (fixo para Drywall)" Margin="0,0,0,4"/>

        <TextBlock Text="Espacamento entre montantes:" FontWeight="Bold" Margin="0,8,0,4"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton x:Name="RadioBtn40" Content="40 cm" GroupName="Espacamento" Margin="0,0,16,0"/>
            <RadioButton x:Name="RadioBtn60" Content="60 cm" GroupName="Espacamento"/>
        </StackPanel>

        <!-- Vaos detectados na parede. So aparece quando a parede tem portas/janelas. -->
        <StackPanel x:Name="PanelVaos" Visibility="Collapsed" Margin="0,0,0,12">
            <TextBlock Text="Vaos da parede:" FontWeight="Bold" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnAjustarVaos" Content="Ajustar vaos..." Padding="10,3"
                        Click="BtnAjustarVaos_Click"/>
                <TextBlock x:Name="TextResumoVaos" VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="Gray" TextWrapping="Wrap" MaxWidth="190"/>
            </StackPanel>
        </StackPanel>

        <CheckBox x:Name="ChkBlocking" Content="Gerar blocking horizontal interno" Margin="0,8,0,0"
                  Checked="ChkBlocking_Checked" Unchecked="ChkBlocking_Checked"/>

        <StackPanel x:Name="PanelBlocking" Visibility="Collapsed" Margin="20,4,0,8">
            <TextBlock Text="Finalidade:" FontWeight="Bold" Margin="0,0,0,2"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <RadioButton x:Name="RadioBlockingTravamento" Content="Travamento" GroupName="BlockingFinalidade" Margin="0,0,12,0"/>
                <RadioButton x:Name="RadioBlockingApoio" Content="Apoio das placas" GroupName="BlockingFinalidade" Margin="0,0,12,0"/>
                <RadioButton x:Name="RadioBlockingAmbas" Content="Ambas" GroupName="BlockingFinalidade"/>
            </StackPanel>

            <TextBlock Text="Alturas (cm, separadas por ; ):" FontWeight="Bold" Margin="0,0,0,2"/>
            <TextBox x:Name="TxtBlockingAlturas" Margin="0,0,0,2"
                     ToolTip="Ex.: 100; 200; 240. Vazio = fileiras automaticas ou juntas das placas."/>
            <TextBlock Text="Vazio usa as fileiras automaticas abaixo." Foreground="Gray" FontSize="11" Margin="0,0,0,6"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Fileiras automaticas:" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtBlockingFileiras" Width="40" Margin="4,0,0,0" ToolTip="1-5"/>
            </StackPanel>

            <CheckBox x:Name="ChkBlockingAlinharJuntas"
                      Content="Alinhar as juntas horizontais das placas (quando existirem)"/>

            <TextBlock Text="Distribuicao:" FontWeight="Bold" Margin="0,6,0,2"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                <RadioButton x:Name="RadioBlockingTodos" Content="Todos os montantes"
                             GroupName="BlockingDistribuicao" Margin="0,0,12,0"/>
                <RadioButton x:Name="RadioBlockingAlternado" Content="Alternado"
                             GroupName="BlockingDistribuicao" Margin="0,0,12,0"/>
            </StackPanel>
            <CheckBox x:Name="ChkBlockingAlternarInverter"
                      Content="Inverter o montante inicial (alternado)"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnCancelar" Content="Cancelar" Width="80" Margin="0,0,8,0" Click="BtnCancelar_Click"/>
            <Button x:Name="BtnGerar" Content="Gerar" Width="80" Click="BtnGerar_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
